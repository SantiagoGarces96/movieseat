# Copia este archivo como .env.local y reemplaza cada valor.
# Nunca subas .env.local al repositorio.

# Conexión a MongoDB (por ejemplo, MongoDB Atlas).
MONGODB_URI=mongodb+srv://usuario:clave@cluster.mongodb.net/movieseat

# Token de lectura de TMDB (themoviedb.org > Ajustes > API).
TMDB_API_TOKEN=TMDB_API_TOKEN

# Texto largo y aleatorio para firmar las sesiones.
JWT_SECRET=JWT_SECRET

# Texto largo y aleatorio. Vercel lo envía a las tareas programadas.
CRON_SECRET=CRON_SECRET

# Solo llaves de prueba de Stripe: con una llave real el pago no funciona.
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Opcional: dirección pública del sitio, para robots.txt y sitemap.xml.
# NEXT_PUBLIC_SITE_URL=https://movieseat.vercel.app

# Solo para npm run create-admin. Borra ADMIN_PASSWORD después de usarlo.
ADMIN_EMAIL=ADMIN_EMAIL
ADMIN_PASSWORD=ADMIN_PASSWORD
ADMIN_NAME=ADMIN_NAME
ADMIN_LAST_NAME=ADMIN_LAST_NAME
